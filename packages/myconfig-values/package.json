{
  "name": "@spautz/myconfig-values",
  "version": "0.0.1",
  "description": "Values for 'myconfig', in my opinionated remote-config-template",
  "keywords": [],
  "license": "MIT",
  "homepage": "https://github.com/spautz/remote-config-template/blob/main/packages/myconfig-values#readme",
  "bugs": "https://github.com/spautz/remote-config-template/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spautz/remote-config-template.git",
    "directory": "packages/myconfig-values"
  },
  "author": {
    "name": "Steven Pautz",
    "url": "https://stevenpautz.com"
  },
  "type": "module",
  "scripts": {
    "____ HOOKS _________________________________________________________": "",
    "prepack": "pnpm run clean && turbo run build",
    "postpack": "pnpm run build:verifypack",
    "____ STANDARD PACKAGE TASKS ________________________________________": "",
    "all": "turbo run pipeline-all",
    "all:ci": "turbo run pipeline-ci --ui=stream",
    "build": "pnpm run build:clean && pnpm run build:values",
    "clean": "pnpm run build:clean && pnpm run test:clean && rimraf --glob ./node_modules/.cache ./.turbo ./*.log",
    "dev": "pnpm run \"/(build:watch|serve:dev)/\"",
    "lint": "biome check --write ",
    "lint:verify": "biome check ",
    "test:clean": "rimraf ./coverage",
    "test": "pnpm run test:clean       && vitest run --coverage",
    "test:ci": "pnpm run test:clean    && vitest run --coverage --bail 1",
    "test:ui": "pnpm run test:clean    && vitest --ui",
    "test:watch": "pnpm run test:clean && vitest watch --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "____ BUILD & VALIDATION TASKS ______________________________________": "",
    "build:clean": "rimraf --glob ./dist ./*.tgz",
    "build:values": "node --experimental-strip-types scripts/build-config-files.ts",
    "build:watch": "node --experimental-strip-types --watch scripts/build-config-files.ts",
    "serve:dev": "serve dist/",
    "serve:prod": "serve dist/"
  },
  "dependencies": {
    "@spautz/myconfig-contracts": "workspace:*"
  },
  "devDependencies": {
    "serve": "14.2.5"
  },
  "peerDependencies": {}
}
