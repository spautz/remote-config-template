{
  "name": "@spautz/remote-config-template--server-demo",
  "private": true,
  "description": "Server-side demo app for the remote-config SDK",
  "license": "MIT",
  "homepage": "https://github.com/spautz/remote-config-template/blob/main/demos/server-demo#readme",
  "bugs": "https://github.com/spautz/remote-config-template/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/spautz/remote-config-template.git",
    "directory": "demos/server-demo"
  },
  "author": {
    "name": "Steven Pautz",
    "url": "https://stevenpautz.com"
  },
  "source": "./src/index.ts",
  "type": "module",
  "scripts": {
    "____ STANDARD PACKAGE TASKS ________________________________________": "",
    "all": "turbo run pipeline-all",
    "all:ci": "turbo run pipeline-ci --ui=stream",
    "build": "pnpm run build:clean && pnpm run build:main",
    "clean": "pnpm run build:clean && pnpm run test:clean && rimraf --glob ./node_modules/.cache ./.turbo ./*.log",
    "dev": "pnpm run start",
    "lint": "oxlint --fix",
    "lint:verify": "oxlint",
    "start": "node ./dist/index.js",
    "test:clean": "rimraf ./coverage",
    "test": "pnpm run test:clean       && vitest run --coverage",
    "test:ci": "pnpm run test:clean    && vitest run --coverage --bail 1",
    "test:ui": "pnpm run test:clean    && vitest --ui",
    "test:watch": "pnpm run test:clean && vitest watch --coverage",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "____ BUILD & DEPLOY TASKS __________________________________________": "",
    "build:clean": "rimraf ./dist",
    "build:main": "vite build",
    "build:watch": "pnpm run build:clean && vite build --watch",
    "size-check": "source-map-explorer dist/**/*.js"
  },
  "dependencies": {
    "@spautz/myconfig-sdk": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
